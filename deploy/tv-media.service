[Unit]
Description=Home media server: recordings copied from the Pi (/mnt/data/tv/rec) for the TV
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/data

[Service]
Type=simple
User=twan
Group=twan
WorkingDirectory=/opt/tv-media
EnvironmentFile=/etc/tv-media.env
ExecStart=/opt/tv-media/venv/bin/python -m app.media
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/mnt/data/tv/rec

[Install]
WantedBy=multi-user.target
